# ---------- Application ----------
APP_NAME=ComicCraft
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
STORAGE_DIR=storage
CORS_ORIGINS=

# ---------- Story generation ----------
# auto = Gemini when a key exists, otherwise demo
# demo = always offline deterministic output
# gemini = require Gemini; optionally fall back if ALLOW_AI_FALLBACK=true
AI_MODE=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_OUTLINE_MODEL=gemini-3.5-flash-lite
GEMINI_STORY_MODEL=gemini-3.5-flash
GEMINI_OUTLINE_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash
GEMINI_STORY_FALLBACK_MODELS=gemini-flash-latest,gemini-3.6-flash
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_SECONDS=1.5
GEMINI_RETRY_MAX_SECONDS=8
ALLOW_AI_FALLBACK=true

# ---------- Panel images ----------
# placeholder | huggingface | diffusers
IMAGE_PROVIDER=placeholder
ALLOW_IMAGE_FALLBACK=true
IMAGE_WIDTH=768
IMAGE_HEIGHT=768

# Hugging Face hosted inference settings
HF_TOKEN=your_huggingface_token_here
HF_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Leave blank for the Hugging Face client default, or use a routed provider name.
HF_PROVIDER=
HF_TIMEOUT_SECONDS=180

# Local Stable Diffusion / Diffusers settings
LOCAL_SD_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
LOCAL_SD_DEVICE=auto
LOCAL_SD_STEPS=25
LOCAL_SD_GUIDANCE=7.0

# ---------- Limits ----------
DEFAULT_PANEL_COUNT=5
MAX_PANEL_COUNT=8
MAX_PROMPT_CHARS=1500
ENABLE_TEST_IMAGE_ENDPOINT=true
KEEP_FAILED_WORKSPACES=false
